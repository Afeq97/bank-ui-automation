# Copy this file to .env and fill in UAT values. NEVER commit .env.
# The suite refuses to run if BASE_URL contains "prod", "live" or "www.".
# Keep comments on their own lines (an inline comment after an empty value is read as the value).

# --- Environment ---
BASE_URL=https://uat.yourbank.example
# chrome | edge | firefox
BROWSER=chrome
HEADLESS=false
# Explicit-wait timeout in seconds
TIMEOUT=15
PAGE_LOAD_TIMEOUT=60
# Set true if UAT uses a self-signed certificate
ACCEPT_INSECURE_CERTS=false

# --- Main test user (dummy UAT account) ---
TEST_USERNAME=
TEST_PASSWORD=
# Fixed OTP configured for UAT test users
TEST_OTP=

# --- Dedicated user for the lockout test ---
# This account WILL be locked by the test. Use a separate dummy user and ask
# the UAT admin to unlock it after each run. Leave empty to skip the test.
LOCKOUT_USERNAME=
LOCKOUT_PASSWORD=

# --- Dummy UAT account numbers ---
# Source account owned by TEST_USERNAME
FROM_ACCOUNT=
# Second account owned by TEST_USERNAME
OWN_TO_ACCOUNT=
# Dummy UAT account owned by another test user
THIRD_PARTY_ACCOUNT=

# --- Session timeout test ---
# App's inactivity timeout in UAT, in seconds. 0 skips the test.
SESSION_TIMEOUT_SECONDS=300
SESSION_TIMEOUT_GRACE_SECONDS=30

# --- Reporting ---
# Mask account numbers / OTP on the page before taking failure screenshots
MASK_SCREENSHOTS=true
